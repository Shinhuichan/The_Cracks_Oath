  m_Script: {fileID: 11500000, guid: 36f56d37b0e3bc245a1bd4ba0a9a2e09, type: 3}
  m_Name: "\uAE40\uD604\uC218"
  m_EditorClassIdentifier: 
  agentName: 1
  title: The Shield
  description: "\uC9C1\uC7A5\uC778\uC73C\uB85C\uC11C\uC758 \uADDC\uCE59\uC801\uC778
    \uC0B6\uC774 \uADF8\uC758 \uC0AC\uACE0\uBC29\uC2DD \uC804\uBC18\uC5D0 \uAE54\uB824
    \uC788\uB2E4. \uADF8\uB294 \uBAA8\uB4E0 \uC0C1\uD669\uC744 \uC218\uCE58\uD654\uD558\uB824
    \uD55C\uB2E4. \uD68C\uC0AC\uC5D0\uC11C \uB370\uC774\uD130 \uBCF4\uACE0\uC11C\uB97C
    \uB2E4\uB8E8\uB358 \uC2B5\uAD00\uC740 \uCE74\uB4DC \uAC8C\uC784\uC5D0\uC11C\uB3C4
    \uADF8\uB300\uB85C \uB4DC\uB7EC\uB09C\uB2E4. \uC190\uD328\uC640 \uB0A8\uC740
    \uB371, \uC0C1\uB300\uC758 \uD50C\uB808\uC774 \uC774\uB825\uAE4C\uC9C0 \uC804\uBD80
    \uCCB4\uACC4\uC801\uC73C\uB85C \uAE30\uB85D\uD55C\uB2E4. \uADF8\uC758 \uBC29\uC5B4\uC801
    \uC120\uD0DD\uC740 \uC885\uC885 \uC9C0\uB8E8\uD574 \uBCF4\uC774\uC9C0\uB9CC,
    \uC808\uB300 \uBB34\uC758\uBBF8\uD558\uC9C0 \uC54A\uB2E4. \u201C\uD328\uBC30\uB294
    \uB2E8 \uD55C \uBC88\uC758 \uC2E4\uC218\uC5D0\uC11C \uC628\uB2E4\u201D\uB77C\uB294
    \uC2E0\uB150\uC744 \uC9C0\uB2CC \uADF8\uB294, \uC2E4\uC218\uB97C \uB9C9\uAE30
    \uC704\uD55C \uC644\uBCBD\uD55C \uACC4\uC0B0\uC744 \uC990\uAE34\uB2E4. \uB3D9\uB9F9
    \uAD00\uACC4\uC5D0\uC11C\uB3C4 \uC2E0\uB8B0\uB97C \uC27D\uAC8C \uC8FC\uC9C0 \uC54A\uC73C\uBA70,
    \uD611\uB825\uD560 \uB54C\uC870\uCC28 \uC2B9\uC0B0 \uC5C6\uB294 \uC5F0\uD569\uC740
    \uC808\uB300 \uC120\uD0DD\uD558\uC9C0 \uC54A\uB294\uB2E4. Recon \uCE74\uB4DC\uB97C
    \uAC00\uC7A5 \uAC00\uCE58 \uC788\uAC8C \uC5EC\uAE30\uBA70, \uC815\uBCF4\uC758
    \uC6B0\uC704\uB97C \uACE7 \uC0DD\uC874\uC73C\uB85C \uBCF8\uB2E4. \uAC10\uC815\uC801
    \uB3D9\uC694\uAC00 \uAC70\uC758 \uC5C6\uACE0, Condition \uBCC0\uD654\uB3C4 \uC548\uC815\uC801\uC774\uB2E4.
    \uAC8C\uC784\uC774 \uC7A5\uAE30\uD654\uB420\uC218\uB85D \uAC15\uD574\uC9C0\uB294
    \uB300\uD45C\uC801\uC778 \u2018\uB0C9\uC18C\uD615 \uC804\uB7B5\uAC00\u2019\uB2E4."
